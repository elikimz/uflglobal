{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [

    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/service-worker.js", "dest": "/service-worker.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/icons/(.*)", "dest": "/icons/$1" },


    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}
